# ============================================================================
# PSTR Tracker — Environment Variables
# Copy to .env and fill in all values. No defaults — all are required.
# ============================================================================

# PostgreSQL password (choose a strong password)
POSTGRES_PASSWORD=

# JWT secret (minimum 32 characters — generate with: openssl rand -base64 48)
JWT_SECRET=

# Supabase keys (generate from JWT_SECRET using supabase CLI or jwt.io)
# Role: anon (public, subject to RLS)
ANON_KEY=
# Role: service_role (bypasses RLS — never expose to frontend)
SERVICE_ROLE_KEY=

# URLs
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:5173

# SMTP (use Inbucket for local dev, corporate SMTP for production)
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_ADMIN_EMAIL=admin@localhost
SMTP_SENDER_NAME=PSTR Tracker

# Vite frontend env vars
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
